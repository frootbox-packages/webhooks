{#- The screen "Webhooks" (decision 0253): every webhook with its state and its last delivery. -#}
{% extends '@backend/layout.twig' %}
{% import '@backend/ui.twig' as ui %}
{% import '@frootbox/webhooks/backend/status.twig' as status %}

{% block title %}{{ t('Webhooks') }}{% endblock %}

{% block content %}
<div class="fb-stack fb-stack--lg">
    <header class="fb-page-header">
        <div class="fb-page-header__text">
            <h1 class="fb-heading-1" tabindex="-1" data-fb-focus>{{ t('Webhooks') }}</h1>
            <p class="fb-muted">{{ t('Tell other services when something changes here, e.g. a shop or a newsletter tool. Each message is signed and sent in the background.') }}</p>
        </div>
        {% if can('frootbox/webhooks/webhook.create') %}<div class="fb-cluster">{{ ui.button({label: t('New webhook'), href: path('frootbox.webhooks.webhooks.new'), icon: 'plus'}) }}</div>{% endif %}
    </header>

    <section class="fb-card" aria-labelledby="webhooks-title">
        <div class="fb-card__header">
            <h2 class="fb-heading-4" id="webhooks-title">{{ t('Webhooks') }}</h2>
            {{ ui.badge('neutral', webhooks|length) }}
        </div>
        {% if webhooks is empty %}
        <div class="fb-card__body">{{ ui.empty({icon: 'external', title: t('No webhooks yet'), text: t('A webhook sends a message to an address whenever one of the chosen actions happens.')}) }}</div>
        {% else %}
        <ul>
            {%- for webhook in webhooks %}
            <li class="fb-list__item">
                <span class="fb-list__main">
                    <a class="fb-list__title" href="{{ path('frootbox.webhooks.webhooks.show', {id: webhook.id}) }}">{{ webhook.title }}</a>
                    <span class="fb-list__meta">{{ webhook.url }} · {{ t(['{count} action', '{count} actions'], {count: webhook.actions|length}) }}</span>
                    {% if webhook.lastDelivery %}<span class="fb-list__meta">{{ t('Last delivery') }}: {{ ui.time(webhook.lastDelivery.createdAt) }}</span>{% endif %}
                </span>
                {{ status.webhook(webhook) }}
                {% if webhook.lastDelivery %}{{ status.delivery(webhook.lastDelivery) }}{% endif %}
            </li>
            {%- endfor %}
        </ul>
        {% endif %}
    </section>
</div>
{% endblock %}
